{
  "name": "diffusers-multi-tenant-lora-serving",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @diffusers-multi-tenant-lora-serving/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "worker": "cd services/worker && .venv/bin/python -m worker",
    "dev:workers": "concurrently -n w1,w2 \"WORKER_ID=w1 ADAPTER_CACHE_DIR=services/worker/.cache/w1 pnpm worker\" \"WORKER_ID=w2 ADAPTER_CACHE_DIR=services/worker/.cache/w2 pnpm worker\"",
    "publish:fixtures": "cd services/api && .venv/bin/python scripts/publish_fixtures.py",
    "build": "pnpm --filter @diffusers-multi-tenant-lora-serving/web build",
    "typecheck": "pnpm --filter @diffusers-multi-tenant-lora-serving/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @diffusers-multi-tenant-lora-serving/web exec vitest run src/lib/api-contract.test.ts",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:check": "node scripts/gen-api.mjs --check && node scripts/gen-docs.mjs --check",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "wait-ready": "node scripts/wait-ready.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm gen:check && pnpm lint && pnpm typecheck && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @diffusers-multi-tenant-lora-serving/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @diffusers-multi-tenant-lora-serving/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "test:worker": "cd services/worker && .venv/bin/python -m pytest",
    "lint:worker": "cd services/worker && .venv/bin/ruff check .",
    "test:live:b2": "cd services/api && .venv/bin/python -m pytest live_tests/test_b2_connectivity.py -m live",
    "selftest": "node scripts/selftest.mjs",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @diffusers-multi-tenant-lora-serving/web exec playwright test --project=chromium",
    "test:verify": "pnpm --filter @diffusers-multi-tenant-lora-serving/web exec playwright test --project=verify"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
