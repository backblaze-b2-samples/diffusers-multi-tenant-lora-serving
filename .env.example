# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# The region in your bucket's S3 endpoint, e.g. s3.<region>.backblazeb2.com.
# The endpoint itself is derived from it, so there is no endpoint variable.
B2_REGION=your-b2-region

# Optional — public base URL for objects, when the bucket is public.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005EXAMPLE_NOT_A_REAL_APP_KEY
# B2_BUCKET_NAME=my-app-uploads
# B2_REGION=us-west-004

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com

# --- LoRA serving (all optional; defaults shown) ---
# Only the dispatcher (services/api) reads the B2_* keys above. Workers read
# just the worker keys below and reach B2 through presigned URLs.

# Shared base model (API and worker). Must match each manifest's base_model.id.
# BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Optional commit pin for the base model download (worker).
# BASE_MODEL_REVISION=
# Key prefix for adapters/, outputs/ and reports/ (API).
# APP_PREFIX=lora-serving/
# Presigned URL lifetimes in seconds (API).
# ADAPTER_URL_TTL_SECONDS=300
# OUTPUT_URL_TTL_SECONDS=600
# Job leases (API): a worker that stops heartbeating loses its job after
# JOB_LEASE_SECONDS; the job is retried with the same seed up to JOB_MAX_ATTEMPTS.
# JOB_LEASE_SECONDS=30
# JOB_HEARTBEAT_SECONDS=5
# JOB_MAX_ATTEMPTS=3
# SQLite job queue file (API), relative to services/api/.
# JOBS_DB_PATH=.data/jobs.sqlite3
# Shared secret for the /worker/* routes (API and worker). Unset = open.
# WORKER_TOKEN=
# Dispatcher address the worker calls.
# API_URL=http://localhost:8000
# Worker name in jobs and reports (default w-<pid>).
# WORKER_ID=
# Worker adapter cache and its LRU limit in bytes (default 4 GiB).
# ADAPTER_CACHE_DIR=services/worker/.cache/adapters
# ADAPTER_CACHE_MAX_BYTES=4294967296
# Re-hash a cached adapter before every load.
# ADAPTER_CACHE_VERIFY_ON_HIT=true
# cuda, mps or cpu (default: autodetect CUDA, then MPS, then CPU).
# TORCH_DEVICE=
# Only for gated or private Hugging Face adapter sources (API).
# HF_TOKEN=
